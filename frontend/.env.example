# Copier ce fichier en .env.local (non versionne) pour le developpement local.
# Les variables VITE_* sont injectees au build (production) ou au demarrage Vite (dev).

# URL de l'API backend.
# Vide ou "/" = meme origine que le frontend (recommande derriere nginx en production).
VITE_API_URL=

# Cible du proxy Vite en developpement uniquement (vite.config.js).
# Adapter au port backend local (ex. 8002).
VITE_API_PROXY_TARGET=http://localhost:8002

# Hotes multi-tenant (production).
VITE_SAAS_HOST=restaurant.bloomarone.com
VITE_PLATFORM_HOST=platform.bloomarone.com
VITE_BASE_DOMAIN=bloomarone.com

# Serveur de dev Vite : hotes autorises separes par des virgules, ou "all".
VITE_DEV_ALLOWED_HOSTS=all
