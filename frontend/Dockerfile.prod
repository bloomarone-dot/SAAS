FROM node:20-alpine AS build

WORKDIR /app
ARG VITE_API_URL=/
ARG VITE_SAAS_HOST=restaurant.bloomarone.com
ARG VITE_PLATFORM_HOST=platform.bloomarone.com
ARG VITE_BASE_DOMAIN=bloomarone.com
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SAAS_HOST=$VITE_SAAS_HOST
ENV VITE_PLATFORM_HOST=$VITE_PLATFORM_HOST
ENV VITE_BASE_DOMAIN=$VITE_BASE_DOMAIN

COPY package*.json ./
RUN npm ci \
    --no-audit \
    --fund=false \
    --fetch-retries=5 \
    --fetch-retry-mintimeout=20000 \
    --fetch-retry-maxtimeout=120000 \
    --fetch-timeout=300000

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
