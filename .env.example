MYSQL_USER=restaurant_user
MYSQL_PASSWORD=restaurant_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=restaurant_saas
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5178,http://127.0.0.1:5173,http://127.0.0.1:5178
RETURN_DEV_RESET_TOKEN=true
SUPERADMIN_EMAIL=superadmin@restaurant.test
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=Superadmin123!
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

# Dans docker-compose, MYSQL_HOST doit pointer vers le service MySQL:
# MYSQL_HOST=db
