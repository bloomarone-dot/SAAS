# Copier ce fichier en .env et remplacer toutes les valeurs change-*.
# Ne jamais commiter un vrai .env.
#
# Documentation detaillee backend : backend/.env.example
# Documentation frontend      : frontend/.env.example
# Template production         : .env.prod.example

# ── Base de donnees ───────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=restaurant_saas
MYSQL_USER=restaurant_user
MYSQL_PASSWORD=change-db-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Refresh tokens & cookies (Phase 3 — fondations, bearer inchangé côté client)
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_BYTES=32
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AUTH_MODE=bearer

LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5178,http://127.0.0.1:5173,http://127.0.0.1:5178
RETURN_DEV_RESET_TOKEN=true
APP_PUBLIC_URL=http://localhost:5178

# ── Multi-tenant ──────────────────────────────────────────────────────────────
TENANT_BASE_DOMAIN=bloomarone.com
TENANT_PLATFORM_HOSTS=restaurant.bloomarone.com,www.restaurant.bloomarone.com,platform.bloomarone.com,www.platform.bloomarone.com

# ── Premier superadmin ────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

# ── Restaurant demo local ─────────────────────────────────────────────────────
SEED_DEMO_RESTAURANT=true
DEMO_ADMIN_PASSWORD=ChangeMe123!

# ── Redis (optionnel en dev) ──────────────────────────────────────────────────
REDIS_URL=

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_NAME=Bloomar One

# ── Orange Money Cameroun ─────────────────────────────────────────────────────
ORANGE_API_URL=https://api-s1.orange.cm
ORANGE_USERNAME=change-orange-username
ORANGE_PASSWORD=change-orange-password
ORANGE_CHANNEL_MSISDN=change-merchant-number
ORANGE_PIN=change-orange-pin
ORANGE_X_AUTH_TOKEN=change-orange-x-auth-token
ORANGE_WEBHOOK_SECRET=change-webhook-secret
ORANGE_WEBHOOK_ALLOWED_IPS=

# ── MTN Mobile Money ──────────────────────────────────────────────────────────
MTN_API_URL=https://api-s1.orange.cm
MTN_CUSTOMER_KEY=
MTN_CUSTOMER_SECRET=
MTN_CLIENT_ID=
MTN_CLIENT_SECRET=
MTN_CHANNEL_MSISDN=
MTN_PIN=
MTN_X_AUTH_TOKEN=
MTN_WEBHOOK_SECRET=
MTN_WEBHOOK_ALLOWED_IPS=

# ── Paiements ─────────────────────────────────────────────────────────────────
PAYMENT_EXPIRY_SECONDS=300
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60

# ── Frontend (build Vite / docker-compose.prod) ───────────────────────────────
VITE_API_URL=/
VITE_SAAS_HOST=restaurant.bloomarone.com
VITE_PLATFORM_HOST=platform.bloomarone.com
VITE_BASE_DOMAIN=bloomarone.com
VITE_DEV_ALLOWED_HOSTS=all
VITE_API_PROXY_TARGET=http://localhost:8002

# ── Docker production ─────────────────────────────────────────────────────────
HTTP_PORT=80
