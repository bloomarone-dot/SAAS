# Variables backend — copier vers .env a la racine du monorepo (docker-compose)
# ou vers backend/.env pour un lancement uvicorn local depuis backend/.

# ── Base de donnees ───────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=restaurant_saas
MYSQL_USER=restaurant_user
MYSQL_PASSWORD=change-db-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Alternative : URL SQLAlchemy complete (prioritaire sur MYSQL_*).
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/restaurant_saas?charset=utf8mb4

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── Refresh tokens & cookies (Phase 3 — fondations, mode bearer par défaut) ──
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_BYTES=32
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AUTH_MODE=bearer

LOG_LEVEL=INFO
UPLOADS_DIR=uploads

# Module cuisine (tickets + écran cuisinier). false = serveur/caissière gère tout.
KITCHEN_ENABLED=false

# CORS (origines separees par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5178,http://127.0.0.1:5173,http://127.0.0.1:5178
# Regex optionnelle pour autoriser des sous-domaines en dev.
# CORS_ALLOW_ORIGIN_REGEX=

# En production : false obligatoire (refuse au demarrage si true).
RETURN_DEV_RESET_TOKEN=true

# ── Multi-tenant ──────────────────────────────────────────────────────────────
TENANT_BASE_DOMAIN=bloomarone.com
TENANT_PLATFORM_HOSTS=restaurant.bloomarone.com,www.restaurant.bloomarone.com,platform.bloomarone.com,www.platform.bloomarone.com
APP_PUBLIC_URL=http://localhost:5178

# ── Premier superadmin ────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

# ── Restaurant demo (developpement uniquement) ────────────────────────────────
SEED_DEMO_RESTAURANT=true
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@leboncoin.test
DEMO_ADMIN_PASSWORD=ChangeMe123!

# ── Redis (rate limit distribue, WebSocket paiements — optionnel en dev) ─────
REDIS_URL=

# ── Email (reinitialisation mot de passe) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_NAME=Bloomar One

# ── Paiements Orange Money Cameroun ───────────────────────────────────────────
ORANGE_API_URL=https://api-s1.orange.cm
ORANGE_USERNAME=
ORANGE_PASSWORD=
ORANGE_CHANNEL_MSISDN=
ORANGE_PIN=
ORANGE_X_AUTH_TOKEN=
ORANGE_WEBHOOK_SECRET=
ORANGE_WEBHOOK_ALLOWED_IPS=

# ── Paiements MTN Mobile Money ────────────────────────────────────────────────
MTN_API_URL=https://api-s1.orange.cm
MTN_CUSTOMER_KEY=
MTN_CUSTOMER_SECRET=
MTN_CLIENT_ID=
MTN_CLIENT_SECRET=
MTN_CHANNEL_MSISDN=
MTN_PIN=
MTN_X_AUTH_TOKEN=
MTN_WEBHOOK_SECRET=
MTN_WEBHOOK_ALLOWED_IPS=

# ── Paiements (delais) ────────────────────────────────────────────────────────
PAYMENT_EXPIRY_SECONDS=300
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60

# ── Abonnements plateforme ────────────────────────────────────────────────────
SUBSCRIPTION_CHECK_INTERVAL_SECONDS=21600

# Voir aussi : /.env.example (stack complete) et /.env.prod.example (production).
